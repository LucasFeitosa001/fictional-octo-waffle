{
  "name": "@beautypass/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac.d.ts",
      "default": "./dist/rbac.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "bootstrap:barbearia-paulista": "tsx prisma/bootstrap-barbearia-paulista.ts",
    "seed:staging": "tsx prisma/seed-staging.ts && tsx prisma/seed-staging-comandas.ts && tsx prisma/seed-staging-caixa.ts && tsx prisma/seed-staging-financeiro.ts && tsx prisma/seed-staging-pacotes.ts && tsx prisma/seed-staging-fornecedores.ts && tsx prisma/seed-staging-marketing.ts && tsx prisma/seed-staging-detalhes.ts && tsx prisma/seed-staging-transacoes.ts",
    "studio": "prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
