// Beautypass — Prisma schema
// Multi-tenant por companyId. Money em Decimal. PK cuid. createdAt/updatedAt.
// Implementa TODAS as entidades de specs/03-data-model/00-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum AuthProvider {
  local
  google
  apple
  phone
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}

enum InviteStatus {
  pending
  accepted
  expired
}

enum CommissionScopeType {
  service
  product
  category
  all
}

enum AmountType {
  percent
  fixed
}

enum InventoryMovementType {
  in
  out
  adjust
}

enum AppointmentStatus {
  scheduled
  confirmed
  unconfirmed
  waiting
  in_progress
  done
  finished
  canceled
}

enum AppointmentSource {
  admin
  online
}

enum OrderStatus {
  open
  finished
  canceled
}

enum OrderItemKind {
  service
  product
}

enum DiscountType {
  percent
  value
}

// De quem sai o valor rateado ao profissional auxiliar (aba Auxiliares do item de serviço).
enum AuxiliaryDiscountFrom {
  establishment
  professional
}

enum PaymentStatus {
  pending
  paid
  reversed
}

enum PackageStatus {
  active
  expired
  finished
}

enum MembershipStatus {
  active
  canceled
  overdue
}

enum FinancialAccountType {
  cash
  bank
}

enum FinancialCategoryKind {
  debit
  credit
}

enum TransactionKind {
  income
  expense
}

enum PartyType {
  customer
  professional
  supplier
}

enum CashRegisterStatus {
  open
  closed
}

enum CashMovementType {
  in
  out
}

enum CommissionEntryStatus {
  open
  paid
  reversed
}

enum CommissionClosingStatus {
  open
  closed
}

// Vale (adiantamento). `open` = concedido, ainda não descontado de um pagamento;
// `deducted` = já abatido no cálculo de um CommissionPayment.
enum CommissionAdvanceStatus {
  open
  deducted
}

enum InvoiceType {
  nfse
  nfe
  nfce
}

enum InvoiceStatus {
  pending
  issued
  canceled
  error
}

enum CampaignChannel {
  whatsapp
  sms
  email
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  canceled
}

enum NotificationChannel {
  whatsapp
  sms
  email
  push
}

enum GoalKind {
  sales
  appointments
  customers
  commission
}

// =====================================================================
// DOMÍNIO: Empresa & Usuários
// =====================================================================

model Company {
  id                    String   @id @default(cuid())
  name                  String
  legalName             String?
  cnpj                  String?
  logoUrl               String?
  // Personalização visual COMPARTILHADA por toda a empresa (Configurações →
  // Personalizar): tema de cores, formato dos botões, sidebar, botão fechar e
  // atalho do CRM. JSON para evoluir o editor sem uma coluna por opção. É a
  // fonte da verdade para TODOS os logins da empresa, em qualquer dispositivo;
  // antes vivia por-usuário em User.appearancePreferences. Só quem tem
  // config:manage altera; qualquer usuário autenticado lê para aplicar o tema.
  appearancePreferences Json?
  timezone              String   @default("America/Sao_Paulo")
  currency              String   @default("BRL")
  addressJson           Json?
  businessHoursJson     Json?
  active                Boolean  @default(true)
  // Cashback — programa global do estabelecimento (Belasis "Programa de Cashback").
  // Config única por empresa; o saldo por cliente vive no ledger CustomerCashback.
  cashbackActive        Boolean  @default(false)
  cashbackValueType     String? // 'percent' | 'value'
  cashbackValue         Decimal? @db.Decimal(12, 2)
  cashbackCanRedeem     Boolean  @default(true)
  cashbackMinimum       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branches              Branch[]
  users                 User[]
  roles                 Role[]
  userCompanies         UserCompany[]
  subscriptions         Subscription[]
  featureFlags          FeatureFlag[]
  customers             Customer[]
  customerFiles         CustomerFile[]
  customerTags          CustomerTag[]
  customerDebts         CustomerDebt[]
  professionals         Professional[]
  professionalInvites   ProfessionalInvite[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  productCategories     ProductCategory[]
  brands                Brand[]
  products              Product[]
  productBatches        ProductBatch[]
  suppliers             Supplier[]
  purchases             Purchase[]
  appointments          Appointment[]
  orders                Order[]
  packageTemplates      PackageTemplate[]
  customerPackages      CustomerPackage[]
  membershipPlans       MembershipPlan[]
  customerMemberships   CustomerMembership[]
  financialAccounts     FinancialAccount[]
  paymentMethods        PaymentMethod[]
  financialCategories   FinancialCategory[]
  transactions          Transaction[]
  cashRegisters         CashRegister[]
  commissionRules       CommissionRule[]
  commissionEntries     CommissionEntry[]
  commissionPayments    CommissionPayment[]
  commissionAdvances    CommissionAdvance[]
  commissionClosings    CommissionClosing[]
  fiscalSettings        FiscalSettings?
  invoices              Invoice[]
  taxProfiles           TaxProfile[]
  bookingLinks          BookingLink[]
  campaigns             Campaign[]
  promotions            Promotion[]
  coupons               Coupon[]
  reviews               Review[]
  cashbackRules         CashbackRule[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  files                 File[]
  documents             Document[]
  documentTemplates     DocumentTemplate[]
  settings              Setting[]
  goals                 Goal[]
  reportsCache          ReportCache[]
  importedXmls          ImportedXml[]
  salonWebProfile       SalonWebProfile?
  galleryPhotos         GalleryPhoto[]
  anamnesisTemplates    AnamnesisTemplate[]
  whatsappOutbox        WhatsappOutbox[]
  whatsappConversations WhatsappConversation[]
  whatsappInboxMessages WhatsappInboxMessage[]
  aiAttendantConfig     AiAttendantConfig?
  salonPayAccount       SalonPayAccount?
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  addressJson Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// AUTH (Better Auth) — multi-tenant decision:
// This is the Better Auth `user` model. Better Auth's required core fields
// (emailVerified, image, sessions, accounts) live here. We KEEP the domain
// fields (companyId, phone, provider, active, etc.). Credentials are stored by
// Better Auth in the Account table (hashed), NOT in passwordHash (kept nullable
// only for legacy/back-compat; new logins go through Better Auth).
// `companyId` is nullable so Better Auth's generic signUpEmail can create a user
// row first; a Better Auth `databaseHook` (user.create.after) then provisions a
// Company and links it, preserving one-company-per-user multi-tenancy.
model User {
  id                    String       @id @default(cuid())
  companyId             String?
  // 'staff' = salon owner/employee (gets a Company on signup); 'customer' = a
  // person booking through the public portal (no Company, links to Customer rows).
  accountType           String       @default("staff")
  name                  String
  email                 String       @unique
  emailVerified         Boolean      @default(false)
  image                 String?
  phone                 String?
  passwordHash          String?
  avatarUrl             String?
  provider              AuthProvider @default(local)
  active                Boolean      @default(true)
  // Per-user notification preferences (Perfil → Notificações). Default ON so
  // legacy accounts keep receiving mail; SMS opt-in stays off until the user
  // wires up their number.
  notifyEmail           Boolean      @default(true)
  notifySms             Boolean      @default(false)
  // Preferência de tema de cores (Personalizar → Tema). Nullable: null → o
  // cliente aplica o default 'salonpass'. Persiste por-usuário na nuvem para
  // sincronizar entre dispositivos.
  themePreference       String?
  // Preferências completas da interface interna (tema, formato dos botões,
  // sidebar, botão fechar e atalho do CRM). JSON permite evoluir o editor sem
  // criar uma coluna nova para cada opção visual; themePreference continua
  // preenchido por compatibilidade com clientes anteriores.
  appearancePreferences Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  company                Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions               Session[]
  accounts               Account[]
  userCompanies          UserCompany[]
  professional           Professional?
  customerProfiles       Customer[]
  customerNotes          CustomerNote[]
  appointmentHistory     AppointmentStatusHistory[]
  orderHistory           OrderStatusHistory[]
  cashRegisters          CashRegister[]             @relation("CashRegisterResponsible")
  closedCashRegisters    CashRegister[]             @relation("CashRegisterCloser")
  reversedTransactions   Transaction[]              @relation("TransactionReversedBy")
  commissionPaymentsPaid CommissionPayment[]        @relation("CommissionPaymentPaidBy")
  auditLogs              AuditLog[]
  notifications          Notification[]

  @@index([companyId])
}

// Better Auth core models. Field set per Better Auth v1 schema.
model Session {
  id              String   @id @default(cuid())
  expiresAt       DateTime
  token           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  userId          String
  // Empresa ativa DESTA sessão (multi-conta). String simples, sem FK, para não
  // acoplar cascades — o valor referencia Company.id e é validado na aplicação.
  activeCompanyId String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id        String   @id @default(cuid())
  companyId String
  // Código estável do papel (owner|manager|receptionist|finance|professional…).
  // É a chave usada pelo resolver de permissões e pelo seed — o `name` é só label.
  code      String
  name      String
  // Papéis padrão semeados pelo sistema (não editáveis/deletáveis pela UI).
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userCompanies   UserCompany[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserCompany {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  roleId      String?
  // Permissões GRANULARES concedidas a ESTE funcionário NESTA empresa (estilo
  // Belasis). Quando não-vazio, sobrescreve o papel: o resolver retorna a UNIÃO
  // dessas chaves + as coarse expandidas (GRANULAR_TO_ENFORCED) para os guards.
  // Vazio ([]) = herda do papel (comportamento legado).
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique // starter|pro|max (legacy: free|basic|premium may linger, unreferenced)
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  featuresJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String
  planId           String
  status           SubscriptionStatus @default(trialing)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  companyId String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Clientes
// =====================================================================

model Customer {
  id                     String    @id @default(cuid())
  companyId              String
  // Optional link to a Better Auth User when the customer booked while logged in
  // through the public portal. Guest bookings leave this null.
  userId                 String?
  name                   String
  nickname               String?
  phone                  String?
  secondaryPhone         String?
  email                  String?
  birthday               DateTime?
  cpf                    String?
  cnpj                   String?
  rg                     String?
  avatarUrl              String?
  // Wave 2/3: endereço embutido no cadastro do cliente + observações livres.
  cep                    String?
  street                 String?
  number                 String?
  district               String?
  city                   String?
  state                  String?
  complement             String?
  // `notes` (a relação CustomerNote[]) já existe — o texto livre de observações
  // do cadastro fica em `observations` para evitar colisão de nome.
  observations           String?
  // Self-referential "indicação": which existing customer referred this one.
  referredById           String?
  // Default discount (%) applied to this customer's orders (Belasis "desconto padrão").
  defaultDiscountPercent Decimal?  @db.Decimal(5, 2)
  // Contact-preference / opt-in toggles (Belasis notification settings per customer).
  notificationsEnabled   Boolean   @default(true)
  whatsappOptIn          Boolean   @default(true)
  smsOptIn               Boolean   @default(true)
  // When true, this customer is blocked from the public/online booking portal.
  onlineAccessBlocked    Boolean   @default(false)
  active                 Boolean   @default(true)
  // Legacy import reconciliation (Belasis). `legacyId` is the source PK,
  // `legacySource` names the origin system. Unique per company for idempotency;
  // Postgres allows multiple NULLs so native rows are unaffected.
  legacyId               String?
  legacySource           String?
  // Soft-delete marker. When set, the record is hidden from every admin list and
  // public-booking read, but the row (and its history) is preserved. `active` is
  // a separate enable/disable toggle and is left untouched on delete.
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  referredBy            Customer?               @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Customer[]              @relation("CustomerReferral")
  addresses             CustomerAddress[]
  credits               CustomerCredit[]
  cashback              CustomerCashback[]
  anamnesis             CustomerAnamnesis[]
  notes                 CustomerNote[]
  files                 CustomerFile[]
  dependents            CustomerDependent[]
  socialProfiles        CustomerSocialProfile[]
  debts                 CustomerDebt[]
  tags                  CustomerTag[]
  appointments          Appointment[]
  orders                Order[]
  customerPackages      CustomerPackage[]
  customerMemberships   CustomerMembership[]
  campaignMessages      CampaignMessage[]
  whatsappOutbox        WhatsappOutbox[]
  whatsappConversations WhatsappConversation[]
  reviews               Review[]

  @@unique([companyId, userId])
  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, name])
  @@index([userId])
  @@index([referredById])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  street     String?
  number     String?
  district   String?
  city       String?
  state      String?
  zip        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCredit {
  id         String   @id @default(cuid())
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  reason     String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCashback {
  id         String    @id @default(cuid())
  customerId String
  amount     Decimal   @db.Decimal(12, 2)
  expiresAt  DateTime?
  sourceType String?
  sourceId   String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerAnamnesis {
  id          String    @id @default(cuid())
  customerId  String
  templateId  String?
  answersJson Json?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Modelo de ficha de anamnese reutilizável (Belasis "Modelos de anamnese").
// questionsJson: array de perguntas configuráveis; instanciado por
// CustomerAnamnesis.answersJson ao preencher a ficha de um cliente.
model AnamnesisTemplate {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  questionsJson Json?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  text       String
  authorId   String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id])

  @@index([customerId])
}

// Wave 4: arquivos/imagens anexados ao cadastro do cliente (Belasis "arquivos").
// A `url` vem do endpoint /uploads (upload direto multipart) já existente.
model CustomerFile {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  url        String
  name       String
  mimeType   String?
  size       Int?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
}

// Dependents of a customer (Belasis "dependentes"). `dependentCustomerId` may
// optionally point at another Customer row when the dependent is also registered.
model CustomerDependent {
  id                  String   @id @default(cuid())
  customerId          String
  name                String
  relationship        String?
  dependentCustomerId String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dependentCustomerId])
}

// Tenant-scoped free-form labels applied to customers (N:N, implicit join table).
model CustomerTag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([companyId, name])
  @@index([companyId])
}

// External social/media profiles linked to a customer (Instagram, WhatsApp, etc.).
model CustomerSocialProfile {
  id         String   @id @default(cuid())
  customerId String
  platform   String
  url        String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Outstanding customer debts (Belasis "débitos/pendências") and their payments.
model CustomerDebt {
  id         String    @id @default(cuid())
  companyId  String
  customerId String
  amount     Decimal   @db.Decimal(12, 2)
  origin     String?
  dueDate    DateTime?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments CustomerDebtPayment[]

  @@index([companyId])
  @@index([customerId])
}

model CustomerDebtPayment {
  id     String   @id @default(cuid())
  debtId String
  amount Decimal  @db.Decimal(12, 2)
  paidAt DateTime @default(now())
  method String?

  debt CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

// =====================================================================
// DOMÍNIO: Profissionais
// =====================================================================

model Professional {
  id                 String    @id @default(cuid())
  companyId          String
  userId             String?   @unique
  name               String
  nickname           String?
  phone              String?
  profession         String?
  birthday           DateTime?
  avatarUrl          String?
  onlineBookable     Boolean   @default(true)
  notifyWhatsapp     Boolean   @default(true)
  active             Boolean   @default(true)
  // Dados cadastrais adicionais (Onda 7): documento (CPF/CNPJ), RG, cargo,
  // observações e flags operacionais.
  document           String?
  rg                 String?
  notes              String?
  position           String?
  receivesCommission Boolean   @default(true)
  generateSchedule   Boolean   @default(true)
  // Endereço embutido (Onda 7 — sem model ProfessionalAddress separado).
  street             String?
  number             String?
  complement         String?
  district           String?
  city               String?
  state              String?
  zip                String?
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId           String?
  legacySource       String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User?                        @relation(fields: [userId], references: [id])
  invites              ProfessionalInvite[]
  schedules            ProfessionalSchedule[]
  services             ProfessionalService[]
  commissionRules      ProfessionalCommissionRule[]
  appointments         Appointment[]
  appointmentItems     AppointmentItem[]
  orders               Order[]
  orderItems           OrderItem[]
  orderItemAuxiliaries OrderItemAuxiliary[]
  commissionEntries    CommissionEntry[]
  commissionPayments   CommissionPayment[]
  commissionAdvances   CommissionAdvance[]
  reviews              Review[]
  goals                Goal[]

  @@unique([companyId, legacyId])
  @@index([companyId])
}

model ProfessionalSchedule {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Int // 0=domingo .. 6=sábado
  startTime      String // HH:mm
  endTime        String
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model ProfessionalCommissionRule {
  id             String              @id @default(cuid())
  professionalId String
  scopeType      CommissionScopeType
  scopeId        String?
  type           AmountType
  value          Decimal             @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalInvite {
  id             String       @id @default(cuid())
  companyId      String
  // Profissional que o convite vincula: ao aceitar, seta Professional.userId = novo
  // User staff. Nullable para convites genéricos (sem profissional pré-cadastrado).
  professionalId String?
  email          String?
  phone          String?
  status         InviteStatus @default(pending)
  token          String       @unique
  // Validade do convite (link expira). Nullable = sem expiração.
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([professionalId])
}

// =====================================================================
// DOMÍNIO: Serviços
// =====================================================================

model ServiceCategory {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Service {
  id                       String    @id @default(cuid())
  companyId                String
  categoryId               String?
  name                     String
  price                    Decimal   @db.Decimal(12, 2)
  // Wave 2/3: tipo de preço (fixo|a_partir_de) e tipo de custo adicional (percent|value).
  priceType                String? // fixo|a_partir_de
  additionalCostType       String? // percent|value
  durationMin              Int       @default(30)
  description              String?
  imageUrl                 String?
  imageUrls                String[]  @default([])
  additionalCost           Decimal   @default(0) @db.Decimal(12, 2)
  cashbackPercent          Decimal   @default(0) @db.Decimal(5, 2)
  // Comissão padrão (%) do serviço. Pode ser sobrescrita pela regra individual
  // do profissional (ProfessionalCommissionRule).
  defaultCommissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  onlineBookable           Boolean   @default(true)
  favorite                 Boolean   @default(false)
  visible                  Boolean   @default(true)
  displayOrder             Int       @default(0)
  active                   Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId                 String?
  legacySource             String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active`/`visible` remain independent toggles.
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             ProductCategory?      @relation(fields: [categoryId], references: [id])
  professionals        ProfessionalService[]
  appointmentItems     AppointmentItem[]
  packageTemplateItems PackageTemplateItem[]
  customerPackageItems CustomerPackageItem[]
  membershipServices   MembershipService[]
  reviews              Review[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([categoryId])
}

// =====================================================================
// DOMÍNIO: Produtos & Estoque
// =====================================================================

model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  services Service[]

  @@index([companyId])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId])
}

model Product {
  id                       String    @id @default(cuid())
  companyId                String
  categoryId               String?
  brandId                  String?
  name                     String
  imageUrl                 String?
  salePrice                Decimal   @db.Decimal(12, 2)
  // Preço especial cobrado de profissionais/funcionários (Belasis "preço para profissional").
  employeePrice            Decimal?  @db.Decimal(12, 2)
  costPrice                Decimal   @default(0) @db.Decimal(12, 2)
  // Custo adicional (frete, impostos) somado ao custo do produto.
  additionalCost           Decimal   @default(0) @db.Decimal(12, 2)
  stock                    Decimal   @default(0) @db.Decimal(12, 3)
  minStock                 Decimal   @default(0) @db.Decimal(12, 3)
  // Unidade de medida (ex.: "un", "ml", "g") e quantas unidades-base equivalem a 1 unidade de venda.
  unit                     String?
  unitEquivalence          Decimal?  @db.Decimal(12, 3)
  // Códigos de identificação: código interno do item e código de barras (EAN/GTIN).
  itemCode                 String?
  barcode                  String?
  // Observações livres sobre o produto.
  observation              String?
  cashbackPercent          Decimal   @default(0) @db.Decimal(5, 2)
  // Comissão padrão (%) aplicada quando o produto é vendido.
  defaultCommissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  // Wave 2/3: controle de estoque explícito e cashback configurável do produto.
  trackStock               Boolean   @default(false)
  cashbackActive           Boolean   @default(false)
  cashbackType             String? // percent|value
  cashbackValue            Decimal?  @db.Decimal(12, 2)
  // Motivo padrão de saída (Registro de saída de estoque).
  exitReason               String?
  favorite                 Boolean   @default(false)
  active                   Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId                 String?
  legacySource             String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ProductCategory?           @relation(fields: [categoryId], references: [id])
  brand              Brand?                     @relation(fields: [brandId], references: [id])
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  batches            ProductBatch[]
  consumedProducts   OrderItemConsumedProduct[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
}

model Supplier {
  id                String    @id @default(cuid())
  companyId         String
  name              String
  email             String?
  phone             String?
  stateRegistration String?
  cnpj              String?
  addressJson       Json?
  active            Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId          String?
  legacySource      String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([companyId, legacyId])
  @@index([companyId])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Decimal               @db.Decimal(12, 3)
  reason    String?
  refType   String?
  refId     String?
  createdAt DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Purchase {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String?
  accountId       String?
  paymentMethodId String?
  // Onda 7: status da nota, número (sem unique — dados legados podem colidir),
  // frete, desconto no total e observações.
  status          String   @default("lancada")
  number          Int?
  // Wave 2/3: número da nota fiscal (texto, sem unique — legados podem colidir)
  // e outras despesas/receitas somadas/subtraídas do total da nota.
  invoiceNumber   String?
  otherExpenses   Decimal  @default(0) @db.Decimal(12, 2)
  otherIncome     Decimal  @default(0) @db.Decimal(12, 2)
  freight         Decimal  @default(0) @db.Decimal(12, 2)
  discount        Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?
  total           Decimal  @default(0) @db.Decimal(12, 2)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  items         PurchaseItem[]

  @@index([companyId])
  @@index([supplierId])
  @@index([companyId, number])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  // Onda 7: desconto por item e total calculado do item.
  discount   Decimal @default(0) @db.Decimal(12, 2)
  total      Decimal @default(0) @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// =====================================================================
// DOMÍNIO: Agenda
// =====================================================================

model Appointment {
  id                 String            @id @default(cuid())
  companyId          String
  customerId         String?
  professionalId     String?
  status             AppointmentStatus @default(scheduled)
  start              DateTime
  end                DateTime
  notes              String?
  remindClient       Boolean?
  // Overrides por agendamento. NULL mantém compatibilidade com registros
  // antigos e faz o backend usar o padrão da empresa em
  // notifications.automation; true/false fixa a decisão para este horário.
  notifyConfirmation Boolean?
  notifyCancellation Boolean?
  // Onda 7: cor de exibição do agendamento na agenda.
  color              String?
  source             AppointmentSource @default(admin)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId           String?
  legacySource       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?                  @relation(fields: [customerId], references: [id])
  professional  Professional?              @relation(fields: [professionalId], references: [id])
  items         AppointmentItem[]
  statusHistory AppointmentStatusHistory[]
  notifications AppointmentNotification[]
  review        Review?

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, start])
  @@index([professionalId, start])
}

model AppointmentItem {
  id             String  @id @default(cuid())
  appointmentId  String
  serviceId      String
  professionalId String?
  durationMin    Int     @default(30)
  price          Decimal @db.Decimal(12, 2)

  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([appointmentId])
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  at            DateTime           @default(now())
  byUserId      String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  byUser      User?       @relation(fields: [byUserId], references: [id])

  @@index([appointmentId])
}

model AppointmentNotification {
  id            String              @id @default(cuid())
  appointmentId String
  type          String
  sentAt        DateTime?
  channel       NotificationChannel

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Business idempotency: the same automation/kind cannot be handled twice for
  // one appointment, even during an App Runner blue/green overlap.
  @@unique([appointmentId, type, channel])
  @@index([appointmentId])
}

// =====================================================================
// DOMÍNIO: Comandas
// =====================================================================

model Order {
  id             String      @id @default(cuid())
  companyId      String
  number         Int
  customerId     String?
  professionalId String?
  status         OrderStatus @default(open)
  grossTotal     Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  creditUsed     Decimal     @default(0) @db.Decimal(12, 2)
  cashbackUsed   Decimal     @default(0) @db.Decimal(12, 2)
  netTotal       Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  date           DateTime    @default(now())
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId       String?
  legacySource   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id])
  professional  Professional?        @relation(fields: [professionalId], references: [id])
  items         OrderItem[]
  discounts     OrderDiscount[]
  payments      OrderPayment[]
  statusHistory OrderStatusHistory[]
  packageUsages PackageUsage[]
  transactions  Transaction[]

  @@unique([companyId, number])
  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, date])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  kind           OrderItemKind
  refId          String // serviceId or productId
  professionalId String?
  quantity       Decimal       @default(1) @db.Decimal(12, 3)
  unitPrice      Decimal       @db.Decimal(12, 2)
  grossValue     Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  packageId      String?
  membershipId   String?
  // Lote do produto (aba "Lote" dos itens de PRODUTO). Nullable — só produtos usam.
  batchId        String?

  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  professional     Professional?              @relation(fields: [professionalId], references: [id])
  batch            ProductBatch?              @relation(fields: [batchId], references: [id])
  auxiliaries      OrderItemAuxiliary[]
  consumedProducts OrderItemConsumedProduct[]

  @@index([orderId])
  @@index([batchId])
}

// Aba "Auxiliares" do item de SERVIÇO — rateio de comissão para um profissional auxiliar.
// Apenas ARMAZENA o rateio; a aplicação real ocorre quando as CommissionEntry forem geradas.
// Não altera grossTotal/netTotal da comanda.
model OrderItemAuxiliary {
  id             String                @id @default(cuid())
  orderItemId    String
  professionalId String // profissional auxiliar que recebe o rateio
  discountFrom   AuxiliaryDiscountFrom // "Desconto do": establishment | professional
  valueType      DiscountType // "Valor (%)": percent | value
  value          Decimal               @db.Decimal(12, 2)
  createdAt      DateTime              @default(now())

  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([orderItemId])
  @@index([professionalId])
}

// Aba "Produtos consumidos" do item de SERVIÇO — produto usado na execução do serviço.
// Gera baixa de estoque (InventoryMovement out) mas NÃO soma no total da comanda.
model OrderItemConsumedProduct {
  id            String   @id @default(cuid())
  orderItemId   String
  productId     String
  batchId       String? // FK -> ProductBatch (campo "Lote")
  quantity      Decimal  @default(1) @db.Decimal(12, 3) // campo "Unidade"
  extraQuantity Decimal  @default(0) @db.Decimal(12, 3) // campo "Extra"
  unitValue     Decimal  @default(0) @db.Decimal(12, 2) // campo "Valor" (custo unitário)
  unit          String? // unidade de medida exibida
  createdAt     DateTime @default(now())

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id])
  batch     ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([orderItemId])
  @@index([productId])
  @@index([batchId])
}

// Lote de produto (aba "Lote" dos itens de produto + Relatórios → Produtos → Lotes).
// Company-scoped p/ multi-tenant.
model ProductBatch {
  id             String    @id @default(cuid())
  companyId      String // multi-tenant
  productId      String
  code           String // "código do lote"
  manufacturedAt DateTime? // fabricação
  expiresAt      DateTime? // validade
  quantity       Decimal   @default(0) @db.Decimal(12, 3) // saldo do lote
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  consumedProducts OrderItemConsumedProduct[]

  @@index([companyId])
  @@index([productId])
}

model OrderDiscount {
  id      String       @id @default(cuid())
  orderId String
  type    DiscountType
  value   Decimal      @db.Decimal(12, 2)
  reason  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderPayment {
  id              String        @id @default(cuid())
  orderId         String
  paymentMethodId String?
  accountId       String?
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  status          PaymentStatus @default(pending)
  description     String?

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  account       FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  at         DateTime     @default(now())
  byUserId   String?

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byUser User? @relation(fields: [byUserId], references: [id])

  @@index([orderId])
}

// =====================================================================
// DOMÍNIO: Pacotes
// =====================================================================

model PackageTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  validityDays Int      @default(0)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items            PackageTemplateItem[]
  customerPackages CustomerPackage[]

  @@index([companyId])
}

model PackageTemplateItem {
  id         String @id @default(cuid())
  templateId String
  serviceId  String
  sessions   Int    @default(1)

  template PackageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id])

  @@index([templateId])
}

model CustomerPackage {
  id           String        @id @default(cuid())
  companyId    String
  customerId   String
  templateId   String?
  number       Int
  price        Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(active)
  expiresAt    DateTime?
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId     String?
  legacySource String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id])
  template PackageTemplate?      @relation(fields: [templateId], references: [id])
  items    CustomerPackageItem[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([customerId])
}

model CustomerPackageItem {
  id                String @id @default(cuid())
  customerPackageId String
  serviceId         String
  sessionsTotal     Int    @default(1)
  sessionsUsed      Int    @default(0)

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id])
  usages          PackageUsage[]

  @@index([customerPackageId])
}

model PackageUsage {
  id                    String   @id @default(cuid())
  customerPackageItemId String
  orderId               String?
  usedAt                DateTime @default(now())

  customerPackageItem CustomerPackageItem @relation(fields: [customerPackageItemId], references: [id], onDelete: Cascade)
  order               Order?              @relation(fields: [orderId], references: [id])

  @@index([customerPackageItemId])
}

// =====================================================================
// DOMÍNIO: Assinaturas (membership)
// =====================================================================

model MembershipPlan {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  recurringPrice Decimal  @db.Decimal(12, 2)
  intervalMonths Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services            MembershipService[]
  customerMemberships CustomerMembership[]

  @@index([companyId])
}

model MembershipService {
  membershipPlanId String
  serviceId        String
  quantityPerCycle Int      @default(1)
  // Wave 4: grid de itens do plano editável — preço/desconto/quantidade por item.
  unitPrice        Decimal? @db.Decimal(12, 2)
  discount         Decimal? @db.Decimal(12, 2)
  quantity         Decimal? @default(1)

  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id])

  @@id([membershipPlanId, serviceId])
  @@index([serviceId])
}

model CustomerMembership {
  id               String           @id @default(cuid())
  companyId        String
  customerId       String
  membershipPlanId String
  status           MembershipStatus @default(active)
  nextDueDate      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id])
  membershipPlan MembershipPlan      @relation(fields: [membershipPlanId], references: [id])
  payments       MembershipPayment[]

  @@index([companyId])
  @@index([customerId])
}

model MembershipPayment {
  id                   String        @id @default(cuid())
  customerMembershipId String
  amount               Decimal       @db.Decimal(12, 2)
  dueDate              DateTime
  paidAt               DateTime?
  status               PaymentStatus @default(pending)

  customerMembership CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)

  @@index([customerMembershipId])
}

// =====================================================================
// DOMÍNIO: Financeiro
// =====================================================================

model FinancialAccount {
  id             String               @id @default(cuid())
  companyId      String
  name           String
  type           FinancialAccountType @default(cash)
  initialBalance Decimal              @default(0) @db.Decimal(12, 2)
  active         Boolean              @default(true)
  // Wave 2/3: conta visível apenas para administradores.
  adminOnly      Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  orderPayments         OrderPayment[]
  purchases             Purchase[]
  paymentMethodsDefault PaymentMethod[]     @relation("PaymentMethodDefaultAccount")
  commissionPayments    CommissionPayment[]

  @@index([companyId])
}

model PaymentMethod {
  id               String   @id @default(cuid())
  companyId        String
  name             String // dinheiro|pix|crédito|débito|outros
  feePercent       Decimal  @default(0) @db.Decimal(5, 2)
  // Wave 2/3: taxa fixa por transação, ativo/inativo, tipo e favorito.
  feeFixed         Decimal  @default(0) @db.Decimal(12, 2)
  active           Boolean  @default(true)
  kind             String? // Tipo (dinheiro|cartao|pix|...)
  favorite         Boolean  @default(false)
  settlementDays   Int      @default(0)
  defaultAccountId String?
  goesToCash       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAccount     FinancialAccount?   @relation("PaymentMethodDefaultAccount", fields: [defaultAccountId], references: [id])
  transactions       Transaction[]
  orderPayments      OrderPayment[]
  purchases          Purchase[]
  cashMovements      CashMovement[]
  commissionPayments CommissionPayment[]

  @@index([companyId])
}

model FinancialCategory {
  id                 String                @id @default(cuid())
  companyId          String
  name               String
  kind               FinancialCategoryKind
  countsAsCommission Boolean               @default(false)
  isExpense          Boolean               @default(false)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([companyId])
}

model Transaction {
  id               String          @id @default(cuid())
  companyId        String
  kind             TransactionKind
  accountId        String?
  categoryId       String?
  paymentMethodId  String?
  partyType        PartyType?
  partyId          String?
  description      String?
  grossAmount      Decimal         @db.Decimal(12, 2)
  dueDate          DateTime?
  paidAt           DateTime?
  // Data de COMPETÊNCIA: o período a que o fato econômico pertence, independente
  // de quando vence ou é pago. Nula por padrão — não retroalimentamos o histórico
  // com dueDate porque seria inventar um dado contábil que ninguém informou.
  competenceDate   DateTime?
  // "É uma receita organizacional?" — despesa/receita da própria empresa
  // (aluguel, imposto, aporte) que NÃO passa pelo caixa da recepção. Quando true,
  // dispensa a exigência de caixa aberto em assertTransactionPolicy.
  isOrganizational Boolean         @default(false)
  status           PaymentStatus   @default(pending)
  recurrenceJson   Json?
  attachmentUrl    String?
  orderId          String?
  // Estorno sem exclusão: quando esta transação é a contrapartida de estorno,
  // `reversalOfId` aponta para a transação original. `reversedAt`/`reversedByUserId`
  // registram quando e por quem a transação original foi estornada.
  reversalOfId     String?
  reversedAt       DateTime?
  reversedByUserId String?
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId         String?
  legacySource     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account        FinancialAccount?  @relation(fields: [accountId], references: [id])
  category       FinancialCategory? @relation(fields: [categoryId], references: [id])
  paymentMethod  PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  order          Order?             @relation(fields: [orderId], references: [id])
  reversalOf     Transaction?       @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals      Transaction[]      @relation("TransactionReversal")
  reversedByUser User?              @relation("TransactionReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, dueDate])
}

model CashRegister {
  id                String             @id @default(cuid())
  companyId         String
  number            Int
  responsibleUserId String?
  openingBalance    Decimal            @default(0) @db.Decimal(12, 2)
  countedBalance    Decimal?           @db.Decimal(12, 2)
  // Conferência de fechamento: saldo esperado (calculado dos movimentos) e a
  // divergência (conferido − esperado). `closedByUserId` = quem fechou o caixa.
  expectedBalance   Decimal?           @db.Decimal(12, 2)
  divergence        Decimal?           @db.Decimal(12, 2)
  closedByUserId    String?
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  status            CashRegisterStatus @default(open)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsibleUser User?          @relation("CashRegisterResponsible", fields: [responsibleUserId], references: [id])
  closedByUser    User?          @relation("CashRegisterCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements       CashMovement[]

  @@unique([companyId, number])
  @@index([companyId])
}

model CashMovement {
  id              String           @id @default(cuid())
  cashRegisterId  String
  type            CashMovementType
  paymentMethodId String?
  amount          Decimal          @db.Decimal(12, 2)
  refType         String?
  refId           String?
  // Descrição livre da movimentação (motivo da sangria/suprimento, etc.).
  description     String?
  at              DateTime         @default(now())

  cashRegister  CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([cashRegisterId])
}

