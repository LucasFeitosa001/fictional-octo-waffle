// Beautypass — Prisma schema
// Multi-tenant por companyId. Money em Decimal. PK cuid. createdAt/updatedAt.
// Implementa TODAS as entidades de specs/03-data-model/00-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum AuthProvider {
  local
  google
  apple
  phone
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}

enum InviteStatus {
  pending
  accepted
  expired
}

enum CommissionScopeType {
  service
  product
  category
  all
}

enum AmountType {
  percent
  fixed
}

enum InventoryMovementType {
  in
  out
  adjust
}

enum AppointmentStatus {
  scheduled
  confirmed
  unconfirmed
  waiting
  in_progress
  done
  finished
  canceled
}

enum AppointmentSource {
  admin
  online
}

enum OrderStatus {
  open
  finished
  canceled
}

enum OrderItemKind {
  service
  product
}

enum DiscountType {
  percent
  value
}

enum PaymentStatus {
  pending
  paid
  reversed
}

enum PackageStatus {
  active
  expired
  finished
}

enum MembershipStatus {
  active
  canceled
  overdue
}

enum FinancialAccountType {
  cash
  bank
}

enum FinancialCategoryKind {
  debit
  credit
}

enum TransactionKind {
  income
  expense
}

enum PartyType {
  customer
  professional
  supplier
}

enum CashRegisterStatus {
  open
  closed
}

enum CashMovementType {
  in
  out
}

enum CommissionEntryStatus {
  open
  paid
  reversed
}

enum CommissionClosingStatus {
  open
  closed
}

enum InvoiceType {
  nfse
  nfe
  nfce
}

enum InvoiceStatus {
  pending
  issued
  canceled
  error
}

enum CampaignChannel {
  whatsapp
  sms
  email
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  canceled
}

enum NotificationChannel {
  whatsapp
  sms
  email
  push
}

enum GoalKind {
  sales
  appointments
  customers
  commission
}

// =====================================================================
// DOMÍNIO: Empresa & Usuários
// =====================================================================

model Company {
  id                String   @id @default(cuid())
  name              String
  legalName         String?
  cnpj              String?
  logoUrl           String?
  timezone          String   @default("America/Sao_Paulo")
  currency          String   @default("BRL")
  addressJson       Json?
  businessHoursJson Json?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branches            Branch[]
  users               User[]
  roles               Role[]
  userCompanies       UserCompany[]
  subscriptions       Subscription[]
  featureFlags        FeatureFlag[]
  customers           Customer[]
  customerTags        CustomerTag[]
  customerDebts       CustomerDebt[]
  professionals       Professional[]
  professionalInvites ProfessionalInvite[]
  serviceCategories   ServiceCategory[]
  services            Service[]
  productCategories   ProductCategory[]
  brands              Brand[]
  products            Product[]
  suppliers           Supplier[]
  purchases           Purchase[]
  appointments        Appointment[]
  orders              Order[]
  packageTemplates    PackageTemplate[]
  customerPackages    CustomerPackage[]
  membershipPlans     MembershipPlan[]
  customerMemberships CustomerMembership[]
  financialAccounts   FinancialAccount[]
  paymentMethods      PaymentMethod[]
  financialCategories FinancialCategory[]
  transactions        Transaction[]
  cashRegisters       CashRegister[]
  commissionRules     CommissionRule[]
  commissionEntries   CommissionEntry[]
  commissionPayments  CommissionPayment[]
  commissionClosings  CommissionClosing[]
  fiscalSettings      FiscalSettings?
  invoices            Invoice[]
  taxProfiles         TaxProfile[]
  bookingLinks        BookingLink[]
  campaigns           Campaign[]
  promotions          Promotion[]
  coupons             Coupon[]
  reviews             Review[]
  cashbackRules       CashbackRule[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  files               File[]
  documents           Document[]
  documentTemplates   DocumentTemplate[]
  settings            Setting[]
  goals               Goal[]
  reportsCache        ReportCache[]
}

model Branch {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  addressJson Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// AUTH (Better Auth) — multi-tenant decision:
// This is the Better Auth `user` model. Better Auth's required core fields
// (emailVerified, image, sessions, accounts) live here. We KEEP the domain
// fields (companyId, phone, provider, active, etc.). Credentials are stored by
// Better Auth in the Account table (hashed), NOT in passwordHash (kept nullable
// only for legacy/back-compat; new logins go through Better Auth).
// `companyId` is nullable so Better Auth's generic signUpEmail can create a user
// row first; a Better Auth `databaseHook` (user.create.after) then provisions a
// Company and links it, preserving one-company-per-user multi-tenancy.
model User {
  id            String       @id @default(cuid())
  companyId     String?
  // 'staff' = salon owner/employee (gets a Company on signup); 'customer' = a
  // person booking through the public portal (no Company, links to Customer rows).
  accountType   String       @default("staff")
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?
  passwordHash  String?
  avatarUrl     String?
  provider      AuthProvider @default(local)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company              Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions             Session[]
  accounts             Account[]
  userCompanies        UserCompany[]
  professional         Professional?
  customerProfiles     Customer[]
  customerNotes        CustomerNote[]
  appointmentHistory   AppointmentStatusHistory[]
  orderHistory         OrderStatusHistory[]
  cashRegisters        CashRegister[]             @relation("CashRegisterResponsible")
  closedCashRegisters  CashRegister[]             @relation("CashRegisterCloser")
  reversedTransactions Transaction[]              @relation("TransactionReversedBy")
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@index([companyId])
}

// Better Auth core models. Field set per Better Auth v1 schema.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userCompanies   UserCompany[]

  @@index([companyId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique // free|basic|pro|premium
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  featuresJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String
  planId           String
  status           SubscriptionStatus @default(trialing)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  companyId String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Clientes
// =====================================================================

model Customer {
  id                     String    @id @default(cuid())
  companyId              String
  // Optional link to a Better Auth User when the customer booked while logged in
  // through the public portal. Guest bookings leave this null.
  userId                 String?
  name                   String
  nickname               String?
  phone                  String?
  secondaryPhone         String?
  email                  String?
  birthday               DateTime?
  cpf                    String?
  cnpj                   String?
  rg                     String?
  avatarUrl              String?
  // Self-referential "indicação": which existing customer referred this one.
  referredById           String?
  // Default discount (%) applied to this customer's orders (Belasis "desconto padrão").
  defaultDiscountPercent Decimal?  @db.Decimal(5, 2)
  // Contact-preference / opt-in toggles (Belasis notification settings per customer).
  notificationsEnabled   Boolean   @default(true)
  whatsappOptIn          Boolean   @default(true)
  smsOptIn               Boolean   @default(true)
  // When true, this customer is blocked from the public/online booking portal.
  onlineAccessBlocked    Boolean   @default(false)
  active                 Boolean   @default(true)
  // Legacy import reconciliation (Belasis). `legacyId` is the source PK,
  // `legacySource` names the origin system. Unique per company for idempotency;
  // Postgres allows multiple NULLs so native rows are unaffected.
  legacyId               String?
  legacySource           String?
  // Soft-delete marker. When set, the record is hidden from every admin list and
  // public-booking read, but the row (and its history) is preserved. `active` is
  // a separate enable/disable toggle and is left untouched on delete.
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  referredBy          Customer?               @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           Customer[]              @relation("CustomerReferral")
  addresses           CustomerAddress[]
  credits             CustomerCredit[]
  cashback            CustomerCashback[]
  anamnesis           CustomerAnamnesis[]
  notes               CustomerNote[]
  dependents          CustomerDependent[]
  socialProfiles      CustomerSocialProfile[]
  debts               CustomerDebt[]
  tags                CustomerTag[]
  appointments        Appointment[]
  orders              Order[]
  customerPackages    CustomerPackage[]
  customerMemberships CustomerMembership[]
  campaignMessages    CampaignMessage[]
  reviews             Review[]

  @@unique([companyId, userId])
  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, name])
  @@index([userId])
  @@index([referredById])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  street     String?
  number     String?
  district   String?
  city       String?
  state      String?
  zip        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCredit {
  id         String   @id @default(cuid())
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  reason     String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerCashback {
  id         String    @id @default(cuid())
  customerId String
  amount     Decimal   @db.Decimal(12, 2)
  expiresAt  DateTime?
  sourceType String?
  sourceId   String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerAnamnesis {
  id          String    @id @default(cuid())
  customerId  String
  templateId  String?
  answersJson Json?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  text       String
  authorId   String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id])

  @@index([customerId])
}

// Dependents of a customer (Belasis "dependentes"). `dependentCustomerId` may
// optionally point at another Customer row when the dependent is also registered.
model CustomerDependent {
  id                  String   @id @default(cuid())
  customerId          String
  name                String
  relationship        String?
  dependentCustomerId String?
  createdAt           DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dependentCustomerId])
}

// Tenant-scoped free-form labels applied to customers (N:N, implicit join table).
model CustomerTag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([companyId, name])
  @@index([companyId])
}

// External social/media profiles linked to a customer (Instagram, WhatsApp, etc.).
model CustomerSocialProfile {
  id         String   @id @default(cuid())
  customerId String
  platform   String
  url        String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// Outstanding customer debts (Belasis "débitos/pendências") and their payments.
model CustomerDebt {
  id         String    @id @default(cuid())
  companyId  String
  customerId String
  amount     Decimal   @db.Decimal(12, 2)
  origin     String?
  dueDate    DateTime?
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments CustomerDebtPayment[]

  @@index([companyId])
  @@index([customerId])
}

model CustomerDebtPayment {
  id     String   @id @default(cuid())
  debtId String
  amount Decimal  @db.Decimal(12, 2)
  paidAt DateTime @default(now())
  method String?

  debt CustomerDebt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

// =====================================================================
// DOMÍNIO: Profissionais
// =====================================================================

model Professional {
  id             String    @id @default(cuid())
  companyId      String
  userId         String?   @unique
  name           String
  nickname       String?
  phone          String?
  profession     String?
  birthday       DateTime?
  avatarUrl      String?
  onlineBookable Boolean   @default(true)
  notifyWhatsapp Boolean   @default(true)
  active         Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId       String?
  legacySource   String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User?                        @relation(fields: [userId], references: [id])
  schedules          ProfessionalSchedule[]
  services           ProfessionalService[]
  commissionRules    ProfessionalCommissionRule[]
  appointments       Appointment[]
  appointmentItems   AppointmentItem[]
  orders             Order[]
  orderItems         OrderItem[]
  commissionEntries  CommissionEntry[]
  commissionPayments CommissionPayment[]
  reviews            Review[]

  @@unique([companyId, legacyId])
  @@index([companyId])
}

model ProfessionalSchedule {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Int // 0=domingo .. 6=sábado
  startTime      String // HH:mm
  endTime        String
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model ProfessionalCommissionRule {
  id             String              @id @default(cuid())
  professionalId String
  scopeType      CommissionScopeType
  scopeId        String?
  type           AmountType
  value          Decimal             @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalInvite {
  id        String       @id @default(cuid())
  companyId String
  email     String?
  phone     String?
  status    InviteStatus @default(pending)
  token     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Serviços
// =====================================================================

model ServiceCategory {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([companyId])
}

model Service {
  id              String    @id @default(cuid())
  companyId       String
  categoryId      String?
  name            String
  price           Decimal   @db.Decimal(12, 2)
  durationMin     Int       @default(30)
  description     String?
  imageUrl        String?
  imageUrls       String[]  @default([])
  additionalCost  Decimal   @default(0) @db.Decimal(12, 2)
  cashbackPercent Decimal   @default(0) @db.Decimal(5, 2)
  onlineBookable  Boolean   @default(true)
  favorite        Boolean   @default(false)
  visible         Boolean   @default(true)
  displayOrder    Int       @default(0)
  active          Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId        String?
  legacySource    String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active`/`visible` remain independent toggles.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             ServiceCategory?      @relation(fields: [categoryId], references: [id])
  professionals        ProfessionalService[]
  appointmentItems     AppointmentItem[]
  packageTemplateItems PackageTemplateItem[]
  customerPackageItems CustomerPackageItem[]
  membershipServices   MembershipService[]
  reviews              Review[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([categoryId])
}

// =====================================================================
// DOMÍNIO: Produtos & Estoque
// =====================================================================

model ProductCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId])
}

model Product {
  id                       String    @id @default(cuid())
  companyId                String
  categoryId               String?
  brandId                  String?
  name                     String
  imageUrl                 String?
  salePrice                Decimal   @db.Decimal(12, 2)
  // Preço especial cobrado de profissionais/funcionários (Belasis "preço para profissional").
  employeePrice            Decimal?  @db.Decimal(12, 2)
  costPrice                Decimal   @default(0) @db.Decimal(12, 2)
  // Custo adicional (frete, impostos) somado ao custo do produto.
  additionalCost           Decimal   @default(0) @db.Decimal(12, 2)
  stock                    Decimal   @default(0) @db.Decimal(12, 3)
  minStock                 Decimal   @default(0) @db.Decimal(12, 3)
  // Unidade de medida (ex.: "un", "ml", "g") e quantas unidades-base equivalem a 1 unidade de venda.
  unit                     String?
  unitEquivalence          Decimal?  @db.Decimal(12, 3)
  // Códigos de identificação: código interno do item e código de barras (EAN/GTIN).
  itemCode                 String?
  barcode                  String?
  // Observações livres sobre o produto.
  observation              String?
  cashbackPercent          Decimal   @default(0) @db.Decimal(5, 2)
  // Comissão padrão (%) aplicada quando o produto é vendido.
  defaultCommissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  favorite                 Boolean   @default(false)
  active                   Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId                 String?
  legacySource             String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ProductCategory?    @relation(fields: [categoryId], references: [id])
  brand              Brand?              @relation(fields: [brandId], references: [id])
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
}

model Supplier {
  id                String    @id @default(cuid())
  companyId         String
  name              String
  email             String?
  phone             String?
  stateRegistration String?
  cnpj              String?
  addressJson       Json?
  active            Boolean   @default(true)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId          String?
  legacySource      String?
  // Soft-delete marker (see Customer.deletedAt). Hidden everywhere when set;
  // `active` remains an independent enable/disable toggle.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([companyId, legacyId])
  @@index([companyId])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Decimal               @db.Decimal(12, 3)
  reason    String?
  refType   String?
  refId     String?
  createdAt DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Purchase {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String?
  accountId       String?
  paymentMethodId String?
  total           Decimal  @default(0) @db.Decimal(12, 2)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  account       FinancialAccount? @relation(fields: [accountId], references: [id])
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  items         PurchaseItem[]

  @@index([companyId])
  @@index([supplierId])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

// =====================================================================
// DOMÍNIO: Agenda
// =====================================================================

model Appointment {
  id             String            @id @default(cuid())
  companyId      String
  customerId     String?
  professionalId String?
  status         AppointmentStatus @default(scheduled)
  start          DateTime
  end            DateTime
  notes          String?
  source         AppointmentSource @default(admin)
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId       String?
  legacySource   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?                  @relation(fields: [customerId], references: [id])
  professional  Professional?              @relation(fields: [professionalId], references: [id])
  items         AppointmentItem[]
  statusHistory AppointmentStatusHistory[]
  notifications AppointmentNotification[]
  review        Review?

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, start])
  @@index([professionalId, start])
}

model AppointmentItem {
  id             String  @id @default(cuid())
  appointmentId  String
  serviceId      String
  professionalId String?
  durationMin    Int     @default(30)
  price          Decimal @db.Decimal(12, 2)

  appointment  Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([appointmentId])
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  at            DateTime           @default(now())
  byUserId      String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  byUser      User?       @relation(fields: [byUserId], references: [id])

  @@index([appointmentId])
}

model AppointmentNotification {
  id            String              @id @default(cuid())
  appointmentId String
  type          String
  sentAt        DateTime?
  channel       NotificationChannel

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// =====================================================================
// DOMÍNIO: Comandas
// =====================================================================

model Order {
  id             String      @id @default(cuid())
  companyId      String
  number         Int
  customerId     String?
  professionalId String?
  status         OrderStatus @default(open)
  grossTotal     Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  creditUsed     Decimal     @default(0) @db.Decimal(12, 2)
  cashbackUsed   Decimal     @default(0) @db.Decimal(12, 2)
  netTotal       Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  date           DateTime    @default(now())
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId       String?
  legacySource   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id])
  professional  Professional?        @relation(fields: [professionalId], references: [id])
  items         OrderItem[]
  discounts     OrderDiscount[]
  payments      OrderPayment[]
  statusHistory OrderStatusHistory[]
  packageUsages PackageUsage[]
  transactions  Transaction[]

  @@unique([companyId, number])
  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, date])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  kind           OrderItemKind
  refId          String // serviceId or productId
  professionalId String?
  quantity       Decimal       @default(1) @db.Decimal(12, 3)
  unitPrice      Decimal       @db.Decimal(12, 2)
  grossValue     Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  packageId      String?
  membershipId   String?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([orderId])
}

model OrderDiscount {
  id      String       @id @default(cuid())
  orderId String
  type    DiscountType
  value   Decimal      @db.Decimal(12, 2)
  reason  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderPayment {
  id              String        @id @default(cuid())
  orderId         String
  paymentMethodId String?
  accountId       String?
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  status          PaymentStatus @default(pending)
  description     String?

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  account       FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  at         DateTime     @default(now())
  byUserId   String?

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byUser User? @relation(fields: [byUserId], references: [id])

  @@index([orderId])
}

// =====================================================================
// DOMÍNIO: Pacotes
// =====================================================================

model PackageTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  validityDays Int      @default(0)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items            PackageTemplateItem[]
  customerPackages CustomerPackage[]

  @@index([companyId])
}

model PackageTemplateItem {
  id         String @id @default(cuid())
  templateId String
  serviceId  String
  sessions   Int    @default(1)

  template PackageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id])

  @@index([templateId])
}

model CustomerPackage {
  id           String        @id @default(cuid())
  companyId    String
  customerId   String
  templateId   String?
  number       Int
  price        Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(active)
  expiresAt    DateTime?
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId     String?
  legacySource String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id])
  template PackageTemplate?      @relation(fields: [templateId], references: [id])
  items    CustomerPackageItem[]

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([customerId])
}

model CustomerPackageItem {
  id                String @id @default(cuid())
  customerPackageId String
  serviceId         String
  sessionsTotal     Int    @default(1)
  sessionsUsed      Int    @default(0)

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id])
  usages          PackageUsage[]

  @@index([customerPackageId])
}

model PackageUsage {
  id                    String   @id @default(cuid())
  customerPackageItemId String
  orderId               String?
  usedAt                DateTime @default(now())

  customerPackageItem CustomerPackageItem @relation(fields: [customerPackageItemId], references: [id], onDelete: Cascade)
  order               Order?              @relation(fields: [orderId], references: [id])

  @@index([customerPackageItemId])
}

// =====================================================================
// DOMÍNIO: Assinaturas (membership)
// =====================================================================

model MembershipPlan {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  recurringPrice Decimal  @db.Decimal(12, 2)
  intervalMonths Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services            MembershipService[]
  customerMemberships CustomerMembership[]

  @@index([companyId])
}

model MembershipService {
  membershipPlanId String
  serviceId        String
  quantityPerCycle Int    @default(1)

  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id])

  @@id([membershipPlanId, serviceId])
  @@index([serviceId])
}

model CustomerMembership {
  id               String           @id @default(cuid())
  companyId        String
  customerId       String
  membershipPlanId String
  status           MembershipStatus @default(active)
  nextDueDate      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id])
  membershipPlan MembershipPlan      @relation(fields: [membershipPlanId], references: [id])
  payments       MembershipPayment[]

  @@index([companyId])
  @@index([customerId])
}

model MembershipPayment {
  id                   String        @id @default(cuid())
  customerMembershipId String
  amount               Decimal       @db.Decimal(12, 2)
  dueDate              DateTime
  paidAt               DateTime?
  status               PaymentStatus @default(pending)

  customerMembership CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)

  @@index([customerMembershipId])
}

// =====================================================================
// DOMÍNIO: Financeiro
// =====================================================================

model FinancialAccount {
  id             String               @id @default(cuid())
  companyId      String
  name           String
  type           FinancialAccountType @default(cash)
  initialBalance Decimal              @default(0) @db.Decimal(12, 2)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  orderPayments         OrderPayment[]
  purchases             Purchase[]
  paymentMethodsDefault PaymentMethod[] @relation("PaymentMethodDefaultAccount")

  @@index([companyId])
}

model PaymentMethod {
  id               String   @id @default(cuid())
  companyId        String
  name             String // dinheiro|pix|crédito|débito|outros
  feePercent       Decimal  @default(0) @db.Decimal(5, 2)
  settlementDays   Int      @default(0)
  defaultAccountId String?
  goesToCash       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultAccount FinancialAccount? @relation("PaymentMethodDefaultAccount", fields: [defaultAccountId], references: [id])
  transactions   Transaction[]
  orderPayments  OrderPayment[]
  purchases      Purchase[]
  cashMovements  CashMovement[]

  @@index([companyId])
}

model FinancialCategory {
  id                 String                @id @default(cuid())
  companyId          String
  name               String
  kind               FinancialCategoryKind
  countsAsCommission Boolean               @default(false)
  isExpense          Boolean               @default(false)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([companyId])
}

model Transaction {
  id               String          @id @default(cuid())
  companyId        String
  kind             TransactionKind
  accountId        String?
  categoryId       String?
  paymentMethodId  String?
  partyType        PartyType?
  partyId          String?
  description      String?
  grossAmount      Decimal         @db.Decimal(12, 2)
  dueDate          DateTime?
  paidAt           DateTime?
  status           PaymentStatus   @default(pending)
  recurrenceJson   Json?
  attachmentUrl    String?
  orderId          String?
  // Estorno sem exclusão: quando esta transação é a contrapartida de estorno,
  // `reversalOfId` aponta para a transação original. `reversedAt`/`reversedByUserId`
  // registram quando e por quem a transação original foi estornada.
  reversalOfId     String?
  reversedAt       DateTime?
  reversedByUserId String?
  // Legacy import reconciliation (Belasis). See Customer.legacyId.
  legacyId         String?
  legacySource     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account        FinancialAccount?  @relation(fields: [accountId], references: [id])
  category       FinancialCategory? @relation(fields: [categoryId], references: [id])
  paymentMethod  PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  order          Order?             @relation(fields: [orderId], references: [id])
  reversalOf     Transaction?       @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals      Transaction[]      @relation("TransactionReversal")
  reversedByUser User?              @relation("TransactionReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, legacyId])
  @@index([companyId])
  @@index([companyId, dueDate])
}

model CashRegister {
  id                String             @id @default(cuid())
  companyId         String
  number            Int
  responsibleUserId String?
  openingBalance    Decimal            @default(0) @db.Decimal(12, 2)
  countedBalance    Decimal?           @db.Decimal(12, 2)
  // Conferência de fechamento: saldo esperado (calculado dos movimentos) e a
  // divergência (conferido − esperado). `closedByUserId` = quem fechou o caixa.
  expectedBalance   Decimal?           @db.Decimal(12, 2)
  divergence        Decimal?           @db.Decimal(12, 2)
  closedByUserId    String?
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  status            CashRegisterStatus @default(open)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsibleUser User?          @relation("CashRegisterResponsible", fields: [responsibleUserId], references: [id])
  closedByUser    User?          @relation("CashRegisterCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements       CashMovement[]

  @@unique([companyId, number])
  @@index([companyId])
}

model CashMovement {
  id              String           @id @default(cuid())
  cashRegisterId  String
  type            CashMovementType
  paymentMethodId String?
  amount          Decimal          @db.Decimal(12, 2)
  refType         String?
  refId           String?
  // Descrição livre da movimentação (motivo da sangria/suprimento, etc.).
  description     String?
  at              DateTime         @default(now())

  cashRegister  CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([cashRegisterId])
}

// =====================================================================
// DOMÍNIO: Comissões
// =====================================================================

model CommissionRule {
  id           String              @id @default(cuid())
  companyId    String
  scopeType    CommissionScopeType
  scopeId      String?
  type         AmountType
  value        Decimal             @db.Decimal(12, 2)
  settingsJson Json? // quem paga taxa/desconto, custo, competência×disponibilidade, todas×finalizadas
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CommissionEntry {
  id               String                @id @default(cuid())
  companyId        String
  professionalId   String
  orderId          String?
  baseAmount       Decimal               @db.Decimal(12, 2)
  commissionAmount Decimal               @db.Decimal(12, 2)
  bonusAmount      Decimal               @default(0) @db.Decimal(12, 2)
  status           CommissionEntryStatus @default(open)
  competenceDate   DateTime?
  availableDate    DateTime?
  signed           Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([companyId])
  @@index([professionalId])
}

model CommissionPayment {
  id             String   @id @default(cuid())
  companyId      String
  professionalId String
  amount         Decimal  @db.Decimal(12, 2)
  paidAt         DateTime @default(now())
  closingId      String?

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id])
  closing      CommissionClosing? @relation(fields: [closingId], references: [id])

  @@index([companyId])
  @@index([professionalId])
}

model CommissionClosing {
  id          String                  @id @default(cuid())
  companyId   String
  periodStart DateTime
  periodEnd   DateTime
  status      CommissionClosingStatus @default(open)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments CommissionPayment[]

  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Fiscal (fase 5)
// =====================================================================

model FiscalSettings {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  municipalRegistration String?
  cnae                  String?
  serviceCode           String?
  taxProfileJson        Json?
  certificateRef        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                   String        @id @default(cuid())
  companyId            String
  orderId              String?
  type                 InvoiceType
  status               InvoiceStatus @default(pending)
  number               String?
  issuedAt             DateTime?
  customerSnapshotJson Json?
  payloadJson          Json?
  returnJson           Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   InvoiceItem[]

  @@index([companyId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model TaxProfile {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rulesJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Marketing
// =====================================================================

model BookingLink {
  id         String   @id @default(cuid())
  companyId  String
  slug       String   @unique
  active     Boolean  @default(true)
  configJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Campaign {
  id          String          @id @default(cuid())
  companyId   String
  name        String
  channel     CampaignChannel
  segmentJson Json?
  status      CampaignStatus  @default(draft)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages CampaignMessage[]

  @@index([companyId])
}

model CampaignMessage {
  id         String    @id @default(cuid())
  campaignId String
  customerId String
  status     String    @default("pending")
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([campaignId])
}

model Promotion {
  id            String              @id @default(cuid())
  companyId     String
  name          String
  scopeType     CommissionScopeType
  scopeId       String?
  discountType  DiscountType
  discountValue Decimal             @db.Decimal(12, 2)
  validFrom     DateTime?
  validTo       DateTime?
  usageLimit    Int?
  appliesOnline Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coupons Coupon[]

  @@index([companyId])
}

model Coupon {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  promotionId String?
  usageLimit  Int?
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
}

model Review {
  id             String   @id @default(cuid())
  companyId      String
  customerId     String?
  professionalId String?
  serviceId      String?
  // Links the review to the specific appointment that was reviewed. Unique so a
  // customer can leave at most one review per finished appointment.
  appointmentId  String?  @unique
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CashbackRule {
  id           String              @id @default(cuid())
  companyId    String
  scopeType    CommissionScopeType
  scopeId      String?
  percent      Decimal             @db.Decimal(5, 2)
  validityDays Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// =====================================================================
// DOMÍNIO: Sistema
// =====================================================================

model Notification {
  id        String    @id @default(cuid())
  companyId String
  userId    String?
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  action     String
  entityType String
  entityId   String?
  dataJson   Json?
  at         DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
}

model File {
  id        String   @id @default(cuid())
  companyId String
  url       String
  mime      String?
  size      Int?
  ownerType String?
  ownerId   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Document {
  id         String   @id @default(cuid())
  companyId  String
  templateId String?
  name       String
  dataJson   Json?
  pdfUrl     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template DocumentTemplate? @relation(fields: [templateId], references: [id])

  @@index([companyId])
}

model DocumentTemplate {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  bodyHtml   String?
  fieldsJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([companyId])
}

model Setting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  valueJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

model Goal {
  id        String              @id @default(cuid())
  companyId String
  period    String // ex: 2026-05
  scopeType CommissionScopeType
  scopeId   String?
  target    Decimal             @db.Decimal(12, 2)
  kind      GoalKind
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ReportCache {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  payloadJson Json?
  generatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
}

// Persisted Baileys (WhatsApp Web) auth state. App Runner has an ephemeral
// filesystem, so storing creds/keys here lets the API reconnect after a restart
// or redeploy without re-scanning the QR. One row per signal item: `category`
// is "creds" (single row, itemId="creds") or a signal key category (pre-key,
// session, sender-key, app-state-sync-key, …); `data` holds the BufferJSON value.
model WhatsappAuthState {
  sessionId String
  category  String
  itemId    String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([sessionId, category, itemId])
}

/// Outbox queue for outgoing WhatsApp messages. Booking/confirmation sends are
/// enqueued here and a single worker (App Runner stays at 1 instance) drains it
/// serially: it only sends while the socket is connected, resolves the real JID
/// via onWhatsApp (handles the BR 9th-digit ambiguity), retries with backoff,
/// and paces sends to avoid WhatsApp ban heuristics. Persisting in Postgres
/// means messages survive a redeploy or a "not connected yet" window instead of
/// being lost by a fire-and-forget send.
model WhatsappOutbox {
  id            String    @id @default(cuid())
  toPhone       String
  text          String
  status        String    @default("pending") // pending | sent | failed
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}
