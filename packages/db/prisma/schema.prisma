// Persisted Baileys (WhatsApp Web) auth state. App Runner has an ephemeral
// filesystem, so storing creds/keys here lets the API reconnect after a restart
// or redeploy without re-scanning the QR. One row per signal item: `category`
// is "creds" (single row, itemId="creds") or a signal key category (pre-key,
// session, sender-key, app-state-sync-key, …); `data` holds the BufferJSON value.
model WhatsappAuthState {
  sessionId String
  category  String
  itemId    String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([sessionId, category, itemId])
}

/// Outbox queue for outgoing WhatsApp messages. Booking/confirmation sends are
/// enqueued here and a single worker (App Runner stays at 1 instance) drains it
/// serially: it only sends while the socket is connected, resolves the real JID
/// via onWhatsApp (handles the BR 9th-digit ambiguity), retries with backoff,
/// and paces sends to avoid WhatsApp ban heuristics. Persisting in Postgres
/// means messages survive a redeploy or a "not connected yet" window instead of
/// being lost by a fire-and-forget send.
model WhatsappOutbox {
  id             String    @id @default(cuid())
  toPhone        String
  // JID resolvido/observado no WhatsApp. Necessário para conversas LID, nas
  // quais o número pode não estar disponível no evento, e também evita uma
  // segunda resolução de destinatário em respostas do inbox.
  toJid          String?
  text           String
  // Mídia opcional do chat. O arquivo é salvo pelo módulo de uploads antes de
  // entrar na fila; assim imagem/áudio têm a mesma durabilidade, pacing e retry
  // dos textos. `mediaType`: image | audio.
  mediaUrl       String?
  mediaType      String?
  mediaMimeType  String?
  mediaFileName  String?
  mediaPtt       Boolean   @default(false)
  status         String    @default("pending") // pending | sent | failed
  attempts       Int       @default(0)
  lastError      String?
  nextAttemptAt  DateTime  @default(now())
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  // Contexto da INTERAÇÃO (histórico de mensagens por cliente — feature "Interações"
  // do Belasis). Nullable p/ retrocompatibilidade: sends antigos/sem contexto (ex.:
  // resposta ao gestor por telefone avulso) continuam válidos sem esses campos.
  // `kind`: reminder | confirmation | cancellation | followup | campaign | invite |
  // manager | manual — texto livre p/ não travar em enum e permitir novos tipos.
  companyId      String?
  customerId     String?
  kind           String?
  // Quando o envio nasceu no inbox (atendente ou IA), permite refletir
  // pending/sent/failed e o id definitivo do WhatsApp na conversa.
  inboxMessageId String?   @unique

  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inboxMessage WhatsappInboxMessage? @relation(fields: [inboxMessageId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([companyId])
  @@index([companyId, toJid])
  @@index([customerId])
}

