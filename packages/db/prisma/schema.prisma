  @@index([companyId])
}

model CommissionEntry {
  id                String                @id @default(cuid())
  companyId         String
  professionalId    String
  orderId           String?
  baseAmount        Decimal               @db.Decimal(12, 2)
  commissionAmount  Decimal               @db.Decimal(12, 2)
  bonusAmount       Decimal               @default(0) @db.Decimal(12, 2)
  // Quanto desta comissão foi repassado a AUXILIARES do item (coluna "Desconto
  // de Auxiliares"). Só é maior que zero quando o auxiliar foi cadastrado com
  // discountFrom = 'professional' — se sai do estabelecimento, o principal não
  // é afetado e este campo fica 0.
  auxiliaryDiscount Decimal               @default(0) @db.Decimal(12, 2)
  status            CommissionEntryStatus @default(open)
  competenceDate    DateTime?
  availableDate     DateTime?
  signed            Boolean               @default(false)
  // Pagamento que quitou este lançamento (null enquanto `open`). Preenchido no
  // pagamento (single/bulk) e zerado no estorno — permite saber quais entries
  // um CommissionPayment cobriu.
  paymentId         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional       @relation(fields: [professionalId], references: [id])
  payment      CommissionPayment? @relation(fields: [paymentId], references: [id])

  @@index([companyId])
  @@index([professionalId])
  @@index([paymentId])
}

model CommissionPayment {
  id              String                @id @default(cuid())
  companyId       String
  professionalId  String
  // amount = commissionTotal + bonusTotal − advancesTotal (nunca negativo).
  amount          Decimal               @db.Decimal(12, 2)
  // Quebra do pagamento (fórmula Belasis: Comissões − Vales + Bonificações).
  commissionTotal Decimal               @default(0) @db.Decimal(12, 2)
  bonusTotal      Decimal               @default(0) @db.Decimal(12, 2)
  advancesTotal   Decimal               @default(0) @db.Decimal(12, 2) // vales descontados
  paidAt          DateTime              @default(now())
  closingId       String?
  // Usuário que efetuou o pagamento (auditoria). Nullable p/ compat legado.
  paidByUserId    String?
  note            String?
  // COMO e DE ONDE saiu o dinheiro. Sem isto o pagamento de comissão não tinha
  // como virar despesa no Financeiro — saía dinheiro do salão e o módulo
  // financeiro nunca ficava sabendo. Nullable por compatibilidade com os
  // pagamentos já registrados antes desta mudança.
  paymentMethodId String?
  accountId       String?
  // Despesa gerada por este pagamento; permite estornar junto no delete.
  transactionId   String?
  // Trilho usado: 'manual' (dinheiro/PIX do próprio salão) ou 'salonpay'.
  rail            CommissionPaymentRail @default(manual)

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional  Professional        @relation(fields: [professionalId], references: [id])
  closing       CommissionClosing?  @relation(fields: [closingId], references: [id])
  paidByUser    User?               @relation("CommissionPaymentPaidBy", fields: [paidByUserId], references: [id])
  paymentMethod PaymentMethod?      @relation(fields: [paymentMethodId], references: [id])
  account       FinancialAccount?   @relation(fields: [accountId], references: [id])
  entries       CommissionEntry[]
  advances      CommissionAdvance[]

  @@index([companyId])
  @@index([professionalId])
}

// Vale (adiantamento dado ao profissional). Concedido em `open` e descontado
