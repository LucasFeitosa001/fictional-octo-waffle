  parkingLot      Boolean  @default(false)
  kids            Boolean  @default(false)
  accessibility   Boolean  @default(false)
  themePreference String?
  schedulingFlow  String?
  requiredLogin   Boolean  @default(false)
  // Cor de destaque (marca) aplicada no agendamento público (web-club): hex
  // "#RRGGBB". Null → o cliente usa a cor padrão (rosa da casa).
  accentColor     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Onda 7: fotos da galeria pública do salão para o agendamento online.
model GalleryPhoto {
  id           String   @id @default(cuid())
  companyId    String
  url          String
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Belasis Etapa 2 — Central de Ajuda (Help Center).
// Artigos carregados a partir de docs/help/*.md no boot da API (frontmatter
// via gray-matter). Não é multi-tenant: base de conhecimento é global do
// produto SalonPass. Usados pelo módulo /help (list/getBySlug/search/chat).
model HelpArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  tags      String[]
  excerpt   String
  icon      String?
  faq       Boolean  @default(false)
  body      String   @db.Text
  updatedAt DateTime @default(now())

  @@index([category])
  @@index([faq])
}

/// Trilho pelo qual a comissão foi paga.
/// `manual` = o salão pagou por fora (dinheiro, PIX próprio, transferência) e
/// apenas registrou aqui. `salonpay` = pago pelo SalonPay, o meio de
/// recebimento/repasse do próprio produto.
enum CommissionPaymentRail {
  manual
  salonpay
}

/// Cadastro de recebimento do SalonPay (KYC de subadquirência) — um por empresa.
///
/// É o formulário "Informe alguns dados para começar a receber os pagamentos
/// online": identifica quem recebe, onde, e por quais meios. Guardar isto NÃO
/// significa que há liquidação: enquanto não houver credencial de um adquirente
/// de verdade, `status` fica em `pending` e nada de dinheiro se move. Fingir o
/// contrário num módulo financeiro é o pior defeito possível — o salão fecha o
/// mês em cima destes números.
model SalonPayAccount {
  id        String         @id @default(cuid())
  companyId String         @unique
  status    SalonPayStatus @default(pending)

  personType SalonPayPersonType @default(company)

  // Pessoa jurídica
  legalName   String? // Razão Social
  companyType String? // Tipo da empresa (LTDA, MEI, SA...)
  taxId       String? // CNPJ (PJ) ou CPF (PF) — só dígitos
  revenue     Decimal? @db.Decimal(14, 2) // Faturamento declarado

  // Responsável / contato
  ownerName String?
  email     String?
  phone     String?

  // Endereço
  zipCode    String?
  street     String?
  number     String?
  district   String?
  city       String?
  state      String?
  complement String?

  // "Receber pagamentos por"
  acceptPix  Boolean @default(true)
  acceptCard Boolean @default(true)

  /// Preenchido quando (e se) um adquirente real for conectado. Enquanto for
  /// null, o cadastro está completo mas não liquida nada.
  providerAccountId String?
  /// Motivo da recusa/pendência devolvido pelo adquirente, para a tela explicar.
  statusReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum SalonPayPersonType {
  individual
  company
}

enum SalonPayStatus {
  /// Cadastro salvo, aguardando conexão com o adquirente.
  pending
  /// Habilitado a receber/repassar.
  active
  /// Recusado — `statusReason` explica.
  rejected
}
