DATABASE_URL="postgresql://beautypass:beautypass@localhost:5432/beautypass?schema=public"
PORT=3333

# Redis (BullMQ) — powers message automations (reminders, follow-ups, campaigns).
REDIS_URL="redis://127.0.0.1:6381"
# Delay (horas) do follow-up automático pós-atendimento.
FOLLOWUP_DELAY_HOURS=24

# Messaging mode: dryrun (default, só loga) | live (envia de verdade via WhatsApp/e-mail).
NOTIFICATIONS_MODE=dryrun
# Liga a conexão Baileys (WhatsApp real). Mantém desligado em dev.
WHATSAPP_ENABLED=false
# Cadência anti-rajada da outbox. Transacionais usam 6–12s; campanhas/follow-ups
# usam 18–35s, com no máximo 60 envios em massa por empresa/hora. Duas mensagens
# automáticas para o mesmo número ficam separadas por pelo menos 60s.
WHATSAPP_DELAY_MIN_MS=6000
WHATSAPP_DELAY_MAX_MS=12000
WHATSAPP_BULK_DELAY_MIN_MS=18000
WHATSAPP_BULK_DELAY_MAX_MS=35000
WHATSAPP_RECIPIENT_COOLDOWN_MS=60000
# Mesma empresa + número + texto dentro desta janela: descarta a duplicata.
WHATSAPP_DEDUP_WINDOW_MS=600000
WHATSAPP_BULK_HOURLY_LIMIT=60

# IA opcional para a recepcionista do inbox. Sem a chave, o atendimento
# continua funcional com o motor determinístico (FAQ, preços e agendamento).
ANTHROPIC_API_KEY=
ANTHROPIC_WHATSAPP_MODEL="claude-haiku-4-5-20251001"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Better Auth (auth lives under /api/v1/auth/*)
BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3333"
AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8081,beautypass://"

# Painel Salonpass Pro: usado para gerar links públicos de convite profissional.
WEB_APP_URL="http://localhost:5173"
