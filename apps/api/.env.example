DATABASE_URL="postgresql://beautypass:beautypass@localhost:5432/beautypass?schema=public"
PORT=3333

# Redis (BullMQ) — powers message automations (reminders, follow-ups, campaigns).
REDIS_URL="redis://127.0.0.1:6381"
# Delay (horas) do follow-up automático pós-atendimento.
FOLLOWUP_DELAY_HOURS=24

# Messaging mode: dryrun (default, só loga) | live (envia de verdade via WhatsApp/e-mail).
NOTIFICATIONS_MODE=dryrun
# Liga a conexão Baileys (WhatsApp real). Mantém desligado em dev.
WHATSAPP_ENABLED=false

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Better Auth (auth lives under /api/v1/auth/*)
BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3333"
AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:8081,beautypass://"

# Painel Salonpass Pro: usado para gerar links públicos de convite profissional.
WEB_APP_URL="http://localhost:5173"
